# ── API SaamBiz ──────────────────────────────────────────────────────────────
# Chemin relatif : en développement, le proxy de Vite (vite.config.js) le
# renvoie vers http://localhost:5000. Le navigateur reste sur une seule
# origine, il n'y a donc aucun CORS à autoriser côté backend.
# En production, mettre ici l'adresse complète de l'API.
VITE_API_BASE_URL=/saambiz/v1

# Site vitrine, pour les liens de retour depuis l'écran de connexion.
VITE_SITE_URL=http://localhost:5199

# ── Mode démo ────────────────────────────────────────────────────────────────
# À 1, l'application tourne sur un jeu de données local, sans appeler l'API.
# Activable aussi à la volée par ?demo=1 dans l'URL (et ?demo=0 pour sortir).
VITE_DEMO=0
