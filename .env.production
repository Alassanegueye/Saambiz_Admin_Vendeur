# ─── Production — app.saambiz.com ───────────────────────────────────────────
# Utilisé par `npm run build` (Vite charge ce fichier en mode production).
# Le .env reste celui du développement local.

# Adresse COMPLÈTE de l'API, suffixe /saambiz/v1 compris : elle part
# directement en baseURL du client axios (src/service/api.js).
# En développement le proxy Vite renvoie /saambiz vers localhost:5000 ; une
# fois construit il n'y a plus de proxy, l'adresse complète est donc requise.
VITE_API_BASE_URL=https://saambiz-back-uj2z.onrender.com/saambiz/v1

# Site vitrine, pour le lien de retour depuis l'écran de connexion.
# Même adresse canonique que VITRINE_BASE_URL côté backend.
VITE_SITE_URL=https://www.saambiz.com

# Mode démo explicitement coupé. Non déclarée, la variable laisse déjà le mode
# inactif — mais un « 1 » oublié ici ferait tourner l'espace vendeur de
# production sur un jeu de données fictif, sans que rien ne le signale à
# l'écran. Autant que la valeur soit écrite.
VITE_DEMO=0
